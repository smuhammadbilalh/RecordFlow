<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RecordFlow.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RecordFlow"
    Title="RecordFlow"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
    FlyoutWidth="320"
   >

    <Shell.Resources>
        <ResourceDictionary>
            <!-- Premium Light Theme -->
            <Color x:Key="PrimaryLight">#6366F1</Color>
            <Color x:Key="PrimaryVariantLight">#4F46E5</Color>
            <Color x:Key="SecondaryLight">#8B5CF6</Color>
            <Color x:Key="AccentLight">#06B6D4</Color>
            <Color x:Key="SurfaceLight">#FFFFFF</Color>
            <Color x:Key="BackgroundLight">#FAFBFF</Color>
            <Color x:Key="CardLight">#F8FAFC</Color>
            <Color x:Key="OnSurfaceLight">#0F172A</Color>
            <Color x:Key="OnBackgroundLight">#1E293B</Color>
            <Color x:Key="BorderLight">#E2E8F0</Color>
            <Color x:Key="SuccessLight">#10B981</Color>
            <Color x:Key="WarningLight">#F59E0B</Color>

            <!-- Premium Dark Theme -->
            <Color x:Key="PrimaryDark">#818CF8</Color>
            <Color x:Key="PrimaryVariantDark">#6366F1</Color>
            <Color x:Key="SecondaryDark">#A78BFA</Color>
            <Color x:Key="AccentDark">#22D3EE</Color>
            <Color x:Key="SurfaceDark">#1E1E1F</Color>
            <Color x:Key="BackgroundDark">#0A0A0B</Color>
            <Color x:Key="CardDark">#18181B</Color>
            <Color x:Key="OnSurfaceDark">#F1F5F9</Color>
            <Color x:Key="OnBackgroundDark">#E2E8F0</Color>
            <Color x:Key="BorderDark">#27272A</Color>
            <Color x:Key="SuccessDark">#34D399</Color>
            <Color x:Key="WarningDark">#FBBF24</Color>

            <!-- Premium Gradients -->
            <LinearGradientBrush x:Key="PrimaryGradientLight" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6366F1" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PrimaryGradientDark" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#818CF8" Offset="0" />
                <GradientStop Color="#A78BFA" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradientLight" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#06B6D4" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradientDark" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#A78BFA" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CreateGradientLight" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6366F1" Offset="0" />
                <GradientStop Color="#4F46E5" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CreateGradientDark" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#818CF8" Offset="0" />
                <GradientStop Color="#6366F1" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ScanGradientLight" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06B6D4" Offset="0" />
                <GradientStop Color="#0891B2" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ScanGradientDark" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#0891B2" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DevGradientLight" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8B5CF6" Offset="0" />
                <GradientStop Color="#7C3AED" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DevGradientDark" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A78BFA" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <!-- Premium Shadows -->
            <Shadow x:Key="CardShadow" Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
            <Shadow x:Key="ButtonShadow" Brush="Black" Offset="0,2" Radius="8" Opacity="0.12" />
            <Shadow x:Key="HeaderShadow" Brush="Black" Offset="0,8" Radius="24" Opacity="0.15" />
        </ResourceDictionary>
    </Shell.Resources>


    <!-- Define Shell Content Pages -->
    <ShellContent
        Title="Record Now"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />


    <ShellContent
        Title="Developer"
        ContentTemplate="{DataTemplate local:DeveloperPage}"
        Route="DeveloperPage" />

    <!-- Professional Flyout Header -->
    <Shell.FlyoutHeader>
        <StackLayout>
            <!-- Header Content -->
            <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=Black}" 
                  HeightRequest="160" 
                  Padding="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- App Icon - Updated with Videocam Icon -->
                <Border Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#2D1B1B}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                    <!-- videocam icon for recording app -->
                    <Label Text="&#xE04B;" 
                           FontFamily="MaterialIcons"
                           FontSize="28"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- App Info -->
                <StackLayout Grid.Column="1" 
                            Margin="16,0,0,0"
                            VerticalOptions="Center"
                            Spacing="4">
                    <Label Text="RecordFlow"
                           FontSize="24"
                           FontAttributes="Bold" />
                    <Label Text="Professional Screen Recording"
                           FontSize="13"
                           Opacity="0.8" />
                </StackLayout>
            </Grid>

            <!-- Premium Separator with Gradient -->
            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" 
                  Padding="20,0">
                <Border HeightRequest="2" 
                        Margin="0,0,0,30"
                        Background="{AppThemeBinding Light={StaticResource AccentGradientLight}, Dark={StaticResource AccentGradientDark}}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="1" />
                    </Border.StrokeShape>
                </Border>
            </Grid>
        </StackLayout>
    </Shell.FlyoutHeader>

    <!-- Premium Navigation Grid -->
    <Shell.FlyoutContent>
        <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
            <StackLayout Padding="20,0,20,20" Spacing="24">

                <!-- Premium Menu Grid -->
                <Grid RowDefinitions="Auto,Auto" 
                      ColumnDefinitions="*,*" 
                      RowSpacing="16" 
                      ColumnSpacing="16">

                    <!-- Record Screen Card -->
                    <Border x:Name="StartRecording" Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 16"
                            Padding="20,24">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStartRecordingTapped" />
                        </Border.GestureRecognizers>

                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <!-- Icon with Gradient Background - Updated with Fiber Manual Record Icon -->
                            <Border WidthRequest="60"
                                    HeightRequest="60"
                                    Background="{AppThemeBinding Light={StaticResource CreateGradientLight}, Dark={StaticResource CreateGradientDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <!-- fiber_manual_record icon (record button) -->
                                <Label Text="&#xE061;" 
                                       FontFamily="MaterialIcons"
                                       FontSize="32"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Record Screen"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                <Label Text="Start recording"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </StackLayout>
                    </Border>

                    <!-- My Recordings Card -->
                    <Border x:Name="MyRecordings" Grid.Row="0" Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 16"
                            Padding="20,24">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMyRecordingsTapped" />
                        </Border.GestureRecognizers>

                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <!-- Icon with Gradient Background - Updated with Video Library Icon -->
                            <Border WidthRequest="60"
                                    HeightRequest="60"
                                    Background="{AppThemeBinding Light={StaticResource ScanGradientLight}, Dark={StaticResource ScanGradientDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <!-- video_library icon for recordings collection -->
                                <Label Text="&#xE02C;" 
                                       FontFamily="MaterialIcons"
                                       FontSize="32"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="My Recordings"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                <Label Text="View recordings"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </StackLayout>
                    </Border>

                    <!-- Developer Tools Card (Spanning 2 Columns) -->
                    <Border x:Name="DeveloperMenu" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 16"
                            Padding="24,20">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeveloperTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <!-- Icon with Gradient Background - Updated with Person Icon -->
                            <Border Grid.Column="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    Background="{AppThemeBinding Light={StaticResource DevGradientLight}, Dark={StaticResource DevGradientDark}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">
                                <!-- person icon for developer/about -->
                                <Label Text="&#xE7FD;" 
                                       FontFamily="MaterialIcons"
                                       FontSize="28"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="About Developer"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                <Label Text="Portfolio and Details of Developer"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Premium Action Buttons with Enhanced Design -->
                <Grid ColumnDefinitions="*,*" 
                      ColumnSpacing="15"
                      Margin="0,0,0,24">

                    <!-- Demo Button with Enhanced Gradient -->
                    <Button Grid.Column="0"
                            Text="Demo"
                            FontSize="13"
                            FontAttributes="Bold"
                            Background="{AppThemeBinding Light={StaticResource PrimaryGradientLight}, Dark={StaticResource PrimaryGradientDark}}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="45"
                            Clicked="OnDemoClicked">
                        <Button.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" 
                                    Offset="0,4" Radius="16" Opacity="0.25" />
                        </Button.Shadow>
                        <Button.ImageSource>
                            <!-- play_arrow icon for demo -->
                            <FontImageSource FontFamily="MaterialIcons" 
                                           Glyph="&#xE037;" 
                                           Color="White" 
                                           Size="16" />
                        </Button.ImageSource>
                    </Button>

                    <!-- Update Button -->
                    <Button Grid.Column="1"
                            Text="Update"
                            FontSize="13"
                            FontAttributes="Bold"
                            Background="{AppThemeBinding Light={StaticResource AccentGradientLight}, Dark={StaticResource AccentGradientDark}}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="45"
                            Clicked="OnUpdateClicked">
                        <Button.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" 
                                    Offset="0,4" Radius="16" Opacity="0.25" />
                        </Button.Shadow>
                        <Button.ImageSource>
                            <!-- system_update icon for update -->
                            <FontImageSource FontFamily="MaterialIcons" 
                                           Glyph="&#xE8D7;" 
                                           Color="White" 
                                           Size="16" />
                        </Button.ImageSource>
                    </Button>
                </Grid>

                <!-- Professional App Branding & Credits -->
                <StackLayout HorizontalOptions="Center" Spacing="8">
                    <!-- Main Brand -->
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8">
                        <Label Text="RecordFlow"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    </StackLayout>

                    <!-- Developer Credit with Style -->
                    <StackLayout Orientation="Horizontal" 
                                 HorizontalOptions="Center"
                                 Spacing="6"
                                 Margin="0,8,0,0">
                        <Label Text="Developed by"
                               FontSize="10"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        <Label Text="Muhammad Bilal"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    </StackLayout>

                    <!-- Version with Professional Badge -->
                    <StackLayout Orientation="Horizontal" 
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 Margin="0,4,0,0">
                        <Label Text="Version"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        <Label Text="•"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        <Label x:Name="appVersion"
                               FontSize="9"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    </StackLayout>
                </StackLayout>

                <!-- Subtle Bottom Accent -->
                <Border HeightRequest="3" 
                        Margin="0,16,0,0"
                        Background="{AppThemeBinding Light={StaticResource PrimaryGradientLight}, Dark={StaticResource PrimaryGradientDark}}"
                        StrokeThickness="0"
                        Opacity="0.3">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="1.5" />
                    </Border.StrokeShape>
                </Border>
            </StackLayout>
        </ScrollView>
    </Shell.FlyoutContent>

</Shell>